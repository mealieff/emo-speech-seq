# Copy to configs/paths.env (done by scripts/setup/install.sh) and edit.
# Environment variables override this file. Relative paths are relative to the repo root.

# MSP-Podcast 1.12 release directory (contains Audios/, Labels/, Partitions.txt).
MSP_ROOT=data/MSP-PODCAST-Publish-1.12

# Where this repo writes processed data and run outputs.
EMOSEQ_DATA=data
EMOSEQ_RUNS=runs
# Concatenated sequence WAVs (15,700 files, about 7.3 GB).
CONCAT_DIR=data/sequences/audio

# Hugging Face hub cache holding the model snapshots (scripts/setup/download_models.py).
MODEL_CACHE=~/.cache/huggingface/hub
# SALMONN components: {vicuna,whisper,beats,salmonn}/
SALMONN_DIR=${MODEL_CACHE}/SALMONN-7B
# IS2025 WavLM categorical checkpoint, seed 7 (final_ssl.pt, final_pool.pt, final_ser.pt, train_norm_stat.pkl).
WAVLM_IS2025_DIR=${MODEL_CACHE}/is2025/cat_ser/7
# WavLM-TimeAug checkpoint used by scripts/inference/wavlm_timeaug.py.
WAVLM_TIMEAUG_CKPT=runs/wavlm_timeaug/seed7/best.pt
# Kimi-Audio source checkout (scripts/setup/install_legacy.sh).
KIMI_AUDIO_ROOT=third_party/Kimi-Audio

# After downloading the models, keep runs on the pinned snapshots:
# HF_HUB_OFFLINE=1
